# ==============================================================================
# ClinicDesk Environment Configuration Template
# ==============================================================================

# Application Base
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ClinicDesk"

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicdesk?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/clinicdesk?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="clinicdesk_super_secret_development_encryption_key_32chars"

# Email Provider (Resend)
RESEND_API_KEY="re_test_mock_resend_api_key_for_development"
EMAIL_FROM_ADDRESS="notifications@clinicdesk.in"

# SMS / WhatsApp Gateway (Sandbox Provider)
SMS_PROVIDER_MODE="sandbox" # "sandbox" | "live"
SMS_GATEWAY_API_KEY="mock_sms_gateway_key"
SMS_SENDER_ID="CLINIC"

# Razorpay Subscription Billing (Test Mode)
RAZORPAY_KEY_ID="rzp_test_mock_key_id"
RAZORPAY_KEY_SECRET="mock_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="mock_razorpay_webhook_secret_key"

# Demo Mode & Environment Flags
ENABLE_DEMO_MODE="true"
DEMO_RESET_PASSCODE="demo-safe-reset-2026"
