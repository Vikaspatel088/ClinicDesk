// Prisma Schema for ClinicDesk — Multi-Tenant Practice Management SaaS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  DOCTOR
  RECEPTIONIST
  PLATFORM_ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  NEW_CONSULTATION
  FOLLOW_UP
  PROCEDURE
  EMERGENCY
  WALK_IN
}

enum ClinicalNoteStatus {
  DRAFT
  FINALIZED
  AMENDED
}

enum ReminderChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum ReminderStatus {
  QUEUED
  SENT
  DELIVERED
  CONFIRMED
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  OTHER
}

enum SubscriptionPlan {
  STARTER
  CLINIC
  MULTI_DOCTOR
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
  UNPAID
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

// -----------------------------------------------------------------------------
// 1. IDENTITY & MULTI-TENANCY
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  memberships           ClinicMembership[]
  appointmentEvents     AppointmentStatusEvent[]
  clinicalNotesAuthored ClinicalNote[]            @relation("AuthoredNotes")
  auditLogs             AuditLog[]

  @@index([email])
}

model Clinic {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  tagline         String?
  phone           String
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  gstin           String?
  currency        String    @default("INR")
  timeZone        String    @default("Asia/Kolkata")
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  memberships       ClinicMembership[]
  doctorProfiles    DoctorProfile[]
  availabilities    DoctorAvailability[]
  patients          Patient[]
  appointments      Appointment[]
  visits            Visit[]
  clinicalNotes     ClinicalNote[]
  vitals            Vital[]
  reminders         Reminder[]
  invoices          Invoice[]
  subscriptions     Subscription[]
  auditLogs         AuditLog[]

  @@index([slug])
  @@index([isDemo])
}

model ClinicMembership {
  id        String          @id @default(uuid())
  userId    String
  clinicId  String
  role      MembershipRole  @default(RECEPTIONIST)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor    DoctorProfile?

  @@unique([userId, clinicId])
  @@index([clinicId, role])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// 2. DOCTOR & CLINICAL SCHEDULING
// -----------------------------------------------------------------------------

model DoctorProfile {
  id                  String            @id @default(uuid())
  clinicId            String
  membershipId        String            @unique
  registrationNumber  String            // MCI / State Medical Council Reg No.
  specialization      String
  qualification       String?
  consultationFee     Float             @default(500.0)
  slotDurationMinutes Int               @default(15)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  clinic              Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  membership          ClinicMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  availabilities      DoctorAvailability[]
  appointments        Appointment[]
  visits              Visit[]
  clinicalNotes       ClinicalNote[]

  @@index([clinicId])
}

model DoctorAvailability {
  id          String        @id @default(uuid())
  clinicId    String
  doctorId    String
  dayOfWeek   Int           // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime   String        // "09:00"
  endTime     String        // "13:00"
  isAvailable Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clinic      Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId, dayOfWeek])
}

// -----------------------------------------------------------------------------
// 3. PATIENTS & MEDICAL RECORDS
// -----------------------------------------------------------------------------

model Patient {
  id                    String                 @id @default(uuid())
  clinicId              String
  mrn                   String                 // Medical Record Number (tenant-scoped)
  name                  String
  phone                 String
  email                 String?
  dateOfBirth           DateTime?
  gender                Gender                 @default(PREFER_NOT_TO_SAY)
  bloodGroup            BloodGroup             @default(UNKNOWN)
  address               String?
  city                  String?
  pincode               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  whatsappConsent       Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  clinic                Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  medicalHistory        PatientMedicalHistory?
  appointments          Appointment[]
  visits                Visit[]
  clinicalNotes         ClinicalNote[]
  vitals                Vital[]
  invoices              Invoice[]

  @@unique([clinicId, mrn])
  @@index([clinicId, phone])
  @@index([clinicId, name])
}

model PatientMedicalHistory {
  id                String    @id @default(uuid())
  clinicId          String
  patientId         String    @unique
  allergies         String[]  @default([])
  chronicConditions String[]  @default([])
  currentMedications String[] @default([])
  pastSurgeries     String[]  @default([])
  familyHistory     String?
  lifestyleNotes    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
}

// -----------------------------------------------------------------------------
// 4. APPOINTMENTS & QUEUE
// -----------------------------------------------------------------------------

model Appointment {
  id              String                  @id @default(uuid())
  clinicId        String
  patientId       String
  doctorId        String
  tokenNumber     Int
  scheduledDate   DateTime                @db.Date
  startTime       DateTime
  endTime         DateTime
  type            AppointmentType         @default(NEW_CONSULTATION)
  status          AppointmentStatus       @default(SCHEDULED)
  reasonForVisit  String?
  notes           String?
  cancellationReason String?
  isWalkIn        Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  clinic          Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          DoctorProfile           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  statusEvents    AppointmentStatusEvent[]
  visit           Visit?
  reminders       Reminder[]
  invoices        Invoice[]

  @@index([clinicId, scheduledDate, doctorId])
  @@index([clinicId, status])
  @@index([clinicId, patientId])
}

model AppointmentStatusEvent {
  id            String            @id @default(uuid())
  clinicId      String
  appointmentId String
  previousStatus AppointmentStatus?
  newStatus     AppointmentStatus
  reason        String?
  changedById   String?
  createdAt     DateTime          @default(now())

  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy     User?             @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([clinicId, appointmentId])
}

// -----------------------------------------------------------------------------
// 5. VISITS & CLINICAL DOCUMENTATION
// -----------------------------------------------------------------------------

model Visit {
  id            String        @id @default(uuid())
  clinicId      String
  patientId     String
  doctorId      String
  appointmentId String?       @unique
  checkInTime   DateTime      @default(now())
  checkOutTime  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clinicalNote  ClinicalNote?
  vitals        Vital[]

  @@index([clinicId, patientId])
  @@index([clinicId, checkInTime])
}

model ClinicalNote {
  id              String             @id @default(uuid())
  clinicId        String
  visitId         String             @unique
  patientId       String
  doctorId        String
  authorId        String
  status          ClinicalNoteStatus @default(DRAFT)
  chiefComplaints String
  examination     String?
  diagnosis       String             // ICD-10 or clinical description
  treatmentPlan   String
  prescription    Json?              // Structured prescription items: medication, dosage, freq, duration
  advice          String?
  followUpDate    DateTime?          @db.Date
  finalizedAt     DateTime?
  amendedReason   String?
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visit           Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor          DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  author          User               @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@index([clinicId, doctorId])
}

model Vital {
  id                String    @id @default(uuid())
  clinicId          String
  visitId           String
  patientId         String
  systolicBp        Int?      // mmHg
  diastolicBp       Int?      // mmHg
  pulseRate         Int?      // bpm
  temperature       Float?    // Fahrenheit
  respiratoryRate   Int?      // breaths/min
  spO2              Int?      // %
  weightKg          Float?    // kg
  heightCm          Float?    // cm
  bmi               Float?
  notes             String?
  recordedAt        DateTime  @default(now())

  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visit             Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, patientId])
  @@index([clinicId, visitId])
}

// -----------------------------------------------------------------------------
// 6. REMINDER PIPELINE
// -----------------------------------------------------------------------------

model Reminder {
  id              String          @id @default(uuid())
  clinicId        String
  appointmentId   String
  channel         ReminderChannel @default(WHATSAPP)
  status          ReminderStatus  @default(QUEUED)
  recipient       String          // Phone or Email
  scheduledFor    DateTime
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  confirmedAt     DateTime?
  failureReason   String?
  isSimulated     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment     Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  events          ReminderEvent[]

  @@index([clinicId, status, scheduledFor])
  @@index([clinicId, appointmentId])
}

model ReminderEvent {
  id          String          @id @default(uuid())
  clinicId    String
  reminderId  String
  eventType   String          // QUEUED, ATTEMPTED, DELIVERED, CONFIRMED, FAILED
  payload     Json?
  timestamp   DateTime        @default(now())

  reminder    Reminder        @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([clinicId, reminderId])
}

// -----------------------------------------------------------------------------
// 7. INVOICING & PATIENT PAYMENTS
// -----------------------------------------------------------------------------

model Invoice {
  id            String            @id @default(uuid())
  clinicId      String
  patientId     String
  appointmentId String?
  invoiceNumber String            // e.g., INV-2026-0001
  status        InvoiceStatus     @default(ISSUED)
  subtotal      Float             @default(0.0)
  discount      Float             @default(0.0)
  taxAmount     Float             @default(0.0) // GST
  totalAmount   Float             @default(0.0)
  amountPaid    Float             @default(0.0)
  balance       Float             @default(0.0)
  issuedAt      DateTime          @default(now())
  dueDate       DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  lineItems     InvoiceLineItem[]
  payments      Payment[]

  @@unique([clinicId, invoiceNumber])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
}

model InvoiceLineItem {
  id          String    @id @default(uuid())
  clinicId    String
  invoiceId   String
  description String
  category    String    @default("Consultation") // Consultation, Procedure, Lab, Medicine
  quantity    Int       @default(1)
  unitPrice   Float
  total       Float
  createdAt   DateTime  @default(now())

  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([clinicId, invoiceId])
}

model Payment {
  id            String        @id @default(uuid())
  clinicId      String
  invoiceId     String
  amount        Float
  method        PaymentMethod @default(CASH)
  transactionRef String?      // UPI Ref, Card Approval Code, Cheque No
  notes         String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())

  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([clinicId, invoiceId])
  @@index([clinicId, paidAt])
}

// -----------------------------------------------------------------------------
// 8. PLATFORM SUBSCRIPTION (CLINICDESK SAAS)
// -----------------------------------------------------------------------------

model Subscription {
  id                    String              @id @default(uuid())
  clinicId              String
  plan                  SubscriptionPlan    @default(STARTER)
  status                SubscriptionStatus  @default(TRIAL)
  razorpaySubscriptionId String?            @unique
  razorpayCustomerId   String?
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  clinic                Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
}

// -----------------------------------------------------------------------------
// 9. SECURITY & AUDIT TRAIL
// -----------------------------------------------------------------------------

model AuditLog {
  id          String    @id @default(uuid())
  clinicId    String?
  userId      String?
  action      String    // e.g., "PATIENT_CREATED", "CLINICAL_NOTE_FINALIZED", "INVOICE_GENERATED"
  entityType  String    // "Patient", "ClinicalNote", "Invoice", "User"
  entityId    String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  clinic      Clinic?   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, entityType, entityId])
  @@index([clinicId, createdAt])
}
